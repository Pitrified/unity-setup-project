/* Menu.uss
   Styles for the main menu screen.
   Reference resolution: 1920x1080 landscape (PanelSettings scale-with-screen).
   Touch targets: buttons are >= 96 px tall in reference resolution,
   which is >= 48 dp on a typical 2x-density Android device.
*/

.menu-root {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(8, 12, 24, 1);
    align-items: stretch;
    justify-content: flex-start;
}

/* safe-area-container: UISystem writes padding here dynamically. */
.safe-area-container {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.menu-panel {
    background-color: rgba(20, 20, 28, 0.95);
    border-radius: 16px;
    padding: 56px;
    min-width: 520px;
    align-items: center;
}

.menu-title {
    color: rgba(255, 255, 255, 1);
    font-size: 64px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 48px;
}

.menu-btn {
    width: 360px;
    height: 96px;
    font-size: 28px;
    -unity-font-style: bold;
    margin-bottom: 20px;
    border-radius: 12px;
    background-color: rgba(60, 100, 180, 1);
    color: rgba(255, 255, 255, 1);
    border-width: 0;
    align-self: center;
}

.menu-btn:hover {
    background-color: rgba(80, 120, 200, 1);
}

.menu-btn:active {
    background-color: rgba(40, 80, 160, 1);
}

.menu-btn:disabled {
    background-color: rgba(50, 50, 60, 1);
    color: rgba(128, 128, 128, 1);
}

.menu-btn--quit {
    background-color: rgba(120, 40, 40, 1);
    margin-top: 20px;
    margin-bottom: 0;
}

.menu-btn--quit:hover {
    background-color: rgba(160, 60, 60, 1);
}

.menu-btn--quit:active {
    background-color: rgba(100, 30, 30, 1);
}
