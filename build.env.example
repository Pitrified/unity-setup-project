# build.env.example
# Template for the build environment variables used by Tools/build-android.sh.
#
# Copy to ~/.config/artificial-pi/build.env and fill in the real values.
# NEVER commit the filled-in file - it contains secrets.
# The example file (this file) is safe to commit.
#
# Setup:
#   mkdir -p ~/.config/artificial-pi
#   cp build.env.example ~/.config/artificial-pi/build.env
#   chmod 600 ~/.config/artificial-pi/build.env
#   # … then edit ~/.config/artificial-pi/build.env

# ── Unity Editor binary ───────────────────────────────────────────────────────
# Absolute path to the Unity Editor binary.
# If unset, the build script scans Unity Hub default locations automatically.
# Override here if you have multiple Unity versions installed.
#
# Linux example:
#   UNITY_PATH=$HOME/Unity/Hub/Editor/6000.4.4f1/Editor/Unity
#
# macOS example:
#   UNITY_PATH=/Applications/Unity/Hub/Editor/6000.4.4f1/Unity.app/Contents/MacOS/Unity
#
# UNITY_PATH=

# ── Android upload keystore (required for `release` builds only) ──────────────
# Generate once with:
#   keytool -genkeypair -keystore keystore/upload.keystore -alias upload \
#           -keyalg RSA -keysize 2048 -validity 10000
# Store the keystore and passwords in your password manager.
# The keystore/ folder and *.keystore files are gitignored.

# Absolute path to the upload keystore file.
ANDROID_KEYSTORE_PATH=/abs/path/to/upload.keystore

# Password for the keystore file.
ANDROID_KEYSTORE_PASS=changeme

# Key alias used when generating the keystore.
ANDROID_KEY_ALIAS=upload

# Password for the key alias (often the same as ANDROID_KEYSTORE_PASS).
ANDROID_KEY_PASS=changeme
